# Copy to .env and adjust. Never commit .env.

# APP_ENV: local | testing | production.
# In local/testing, `composer seed` also creates a `local-dev` client with a fixed API token:
#   gk_test_000000000000dead.localdevsecretlocaldevsecret1234
# The seeder is a no-op in production.
APP_ENV=local
APP_DEBUG=true

# Base64 32-byte key used to encrypt provider secret keys (Phase 9).
# Generate: php -r "echo base64_encode(random_bytes(32));"
# Required once provider accounts exist; keep it out of version control.
APP_ENCRYPTION_KEY=

# Database (defaults match docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gomrok
DB_USER=gomrok
DB_PASSWORD=gomrok
DB_CHARSET=utf8mb4
