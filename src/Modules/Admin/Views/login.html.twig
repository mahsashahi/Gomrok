{% extends 'layouts/base.html.twig' %}

{% block title %}Sign in — Gomrok Admin{% endblock %}

{% block body %}
<div class="login-page">
  <div class="login-card">
    <div class="login-brand">
      <div class="brand-mark"></div>
      <div class="brand-name">Gomrok</div>
    </div>
    <h1 class="login-title">Admin sign in</h1>
    <p class="login-subtitle">Sign in with your admin account to continue.</p>

    {% if error %}
    <div class="form-error">{{ error }}</div>
    {% endif %}

    <form method="post" action="/admin/login{{ return_to ? '?return_to=' ~ return_to|url_encode : '' }}">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="{{ email|default('') }}" autocomplete="username" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
      </div>
      <button type="submit" class="login-submit">Sign in</button>
    </form>
  </div>
</div>
{% endblock %}
