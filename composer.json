{
    "name": "gomrok/gomrok",
    "description": "Gomrok — standalone multi-client payment orchestration service",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "robmorgan/phinx": "^0.16.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "Gomrok\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gomrok\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:all": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "migrate": "phinx migrate",
        "rollback": "phinx rollback",
        "ci": [
            "@cs",
            "@stan",
            "@test"
        ],
        "ci:full": [
            "@cs",
            "@stan",
            "@test:all"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the unit test suite",
        "test:integration": "Run the integration test suite (needs MySQL)",
        "test:all": "Run every test suite",
        "stan": "Run PHPStan static analysis",
        "cs": "Check code style (php-cs-fixer, dry run)",
        "cs:fix": "Apply code-style fixes",
        "migrate": "Run pending database migrations (Phinx)",
        "rollback": "Roll back the last database migration",
        "ci": "Local CI: code style, static analysis, unit tests (no infrastructure)",
        "ci:full": "ci plus the integration suite (needs MySQL: docker compose up -d mysql)"
    }
}
